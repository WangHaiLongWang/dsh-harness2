{
  "name": "dsh-plugin-harness2",
  "version": "0.1.0",
  "description": "Recursive Harness² orchestration plugins for DSH/Cordis",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "llm-agent",
    "harness2",
    "recursive-self-improvement"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WangHaiLongWang/dsh-harness2.git"
  },
  "bugs": {
    "url": "https://github.com/WangHaiLongWang/dsh-harness2/issues"
  },
  "homepage": "https://github.com/WangHaiLongWang/dsh-harness2#readme",
  "type": "module",
  "main": "dist/src/dsh/index.js",
  "types": "dist/src/dsh/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/dsh/index.d.ts",
      "import": "./dist/src/dsh/index.js"
    },
    "./core": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./dist/src/panel/types.d.ts",
      "import": "./dist/src/panel/types.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist/src",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/*.md",
    "examples/*",
    "locale/*.json",
    "cordis.patch.yml"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "link:dsh": "node scripts/link-dsh.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && npm run build:panel",
    "build:panel": "node scripts/build-panel.mjs",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "demo": "npm run build && node dist/src/demo.js",
    "eval:report": "npm run build && node scripts/evaluate.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "check": "npm run check:repo && npm test && npm audit --audit-level=high --registry=https://registry.npmjs.org && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-shell": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "4.0.2-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-brand": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-store": { "optional": true },
    "@deepseek-ai/dsh-client-ui-layout": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-renderer": { "optional": true },
    "@deepseek-ai/dsh-client-ui-sidebar": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": { "optional": true },
    "@deepseek-ai/dsh-skill": { "optional": true },
    "@deepseek-ai/dsh-subagent": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "react": "^19.3.1",
    "react-dom": "^18.2.0",
    "typescript": "^5.7.0"
  }
}
