{
  "name": "dsh-plugin-harness2",
  "version": "0.1.0",
  "description": "Recursive Harness² orchestration plugins for DSH/Cordis",
  "type": "module",
  "main": "dist/src/dsh/index.js",
  "types": "dist/src/dsh/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/dsh/index.d.ts",
      "import": "./dist/src/dsh/index.js"
    },
    "./core": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "link:dsh": "node scripts/link-dsh.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "demo": "npm run build && node dist/src/demo.js",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "4.0.2-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-brand": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
